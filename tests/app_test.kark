func test_process_record_parsing() {
    let rec = "PROCESS|1200|scheduler|4"
    let f = split(rec, "|")
    assert_eq(f[0], "PROCESS")
    assert_eq(int(f[1]), 1200)
    assert_eq(f[2], "scheduler")
    assert_eq(int(f[3]), 4)
}

func test_parent_and_children_core() {
    let state = ["PARENT|1200|1000", "PARENT|1300|1000", "PARENT|1400|1200"]
    let i = 0
    let kids = []
    while (i < len(state)) {
        let f = split(state[i], "|")
        if (int(f[2]) == 1000) { push(kids, int(f[1])) }
        i = i + 1
    }
    assert_eq(len(kids), 2)
    assert_eq(kids[0], 1200)
    assert_eq(kids[1], 1300)
}

func test_tree_bfs_core() {
    let queue = [1000]
    let visited = []
    while (len(queue) > 0) {
        let pid = queue[0]
        let rest = []
        let i = 1
        while (i < len(queue)) {
            push(rest, queue[i])
            i = i + 1
        }
        queue = rest
        push(visited, pid)
        if (pid == 1000) { push(queue, 1200); push(queue, 1300) }
        if (pid == 1200) { push(queue, 1400) }
    }
    assert_eq(len(visited), 4)
    assert_eq(visited[0], 1000)
    assert_eq(visited[3], 1400)
}
